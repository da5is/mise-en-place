#!/usr/bin/env bash
set -euo pipefail

case "$(dpkg --print-architecture)" in
  amd64) arch="x64" ;;
  arm64) arch="arm64" ;;
  *) echo "Unsupported architecture" >&2; exit 1 ;;
esac

url="https://github.com/github/app/releases/latest/download/GitHub-Copilot-linux-${arch}.deb"

tmp="$(mktemp --suffix=.deb)"
trap 'rm -f "$tmp"' EXIT

curl -fL --retry 3 -o "$tmp" "$url"
sudo apt-get install -y "$tmp"
